# Inside Docker the process listens on 8080; Compose maps host 38477 → 8080.
PORT=8080

# Public HTTPS origin via Cloudflare Tunnel (no trailing slash).
# Example: https://uni-share.example.com
PUBLIC_BASE_URL=http://127.0.0.1:38477

# Optional: iCloud link after Share → Copy iCloud Link in Shortcuts
# (landing Add Shortcut prefers this; otherwise it serves UNI-SHARE.shortcut)
# SHORTCUT_INSTALL_URL=https://www.icloud.com/shortcuts/xxxxxxxx

# Storefront / market used for Apple Music lookups
DEFAULT_COUNTRY=US

# Optional but recommended: Spotify Web API client credentials
# Create an app at https://developer.spotify.com/dashboard
# Put values only in this .env file on the host — never commit them.
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=

# Optional alternative: SongPort managed conversion (invite key)
# SONGPORT_API_KEY=
