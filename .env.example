# HTTP listen port
PORT=8080

# Public HTTPS origin of THIS API (no trailing slash).
# Used by /api/v1/config and by the Shortcut convert endpoint.
# Example after Render deploy: https://uni-share-api.onrender.com
PUBLIC_BASE_URL=http://127.0.0.1:8080

# On Vercel (frontend build), set API_BASE_URL to that same API origin so the
# static site calls Render instead of assuming same-origin.

# Optional: iCloud link to your published Shortcut (makes Add Shortcut one-tap)
# SHORTCUT_INSTALL_URL=https://www.icloud.com/shortcuts/xxxxxxxx

# Storefront / market used for Apple Music lookups
DEFAULT_COUNTRY=US

# Optional but recommended: Spotify Web API client credentials
# Improves Spotify as a conversion target when song.link omits a Spotify URL.
# Create an app at https://developer.spotify.com/dashboard — put values only in
# .env locally or in the host secret UI (never commit them).
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=

# Optional alternative: SongPort managed conversion (invite key)
# When set, can be wired in later as a primary provider.
# SONGPORT_API_KEY=
